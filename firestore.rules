rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isAuthed()
        && userExists(request.auth.uid)
        && userDoc(request.auth.uid).role == 'admin';
    }

    function isValidRole(role) {
      return role in ['admin', 'viewer'];
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    function isOptionalString(v) {
      return v == null || v is string;
    }

    function isNumber(v) {
      return v is number;
    }

    function isNonNegative(v) {
      return v is number && v >= 0;
    }

    // ===== users =====
    match /users/{uid} {
      allow read: if isAuthed();

      // Юзер сам створює свій документ при першому вході.
      // Дозволяємо роль 'admin' тільки якщо це САМ-перший користувач у системі
      // (на практиці перевіряємо клієнтом; для додаткової безпеки після bootstrap
      // адмін через консоль може посилити правило).
      allow create: if isAuthed()
        && request.auth.uid == uid
        && request.resource.data.email is string
        && isOptionalString(request.resource.data.name)
        && isValidRole(request.resource.data.role);

      // Юзер може редагувати свій документ, АЛЕ не може змінити роль.
      // Роль змінює тільки адмін.
      allow update: if isAuthed() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role)
        || (isAdmin() && isValidRole(request.resource.data.role))
      );

      allow delete: if isAdmin();
    }

    // ===== categories =====
    match /categories/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.color is string;
      allow delete: if isAdmin();
    }

    // ===== products =====
    match /products/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && (request.resource.data.unit == null || request.resource.data.unit is string)
        && (request.resource.data.defaultPrice == null || isNonNegative(request.resource.data.defaultPrice));
      allow delete: if isAdmin();
    }

    // ===== suppliers =====
    match /suppliers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isNonEmptyString(request.resource.data.name);
      allow delete: if isAdmin();
    }

    // ===== customers =====
    match /customers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isNonEmptyString(request.resource.data.name);
      allow delete: if isAdmin();
    }

    // ===== orders =====
    match /orders/{id} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.status in ['new', 'confirmed', 'in_progress', 'ready', 'delivered', 'cancelled']
        && isNonNegative(request.resource.data.totalAmount)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.status in ['new', 'confirmed', 'in_progress', 'ready', 'delivered', 'cancelled']
        && isNonNegative(request.resource.data.totalAmount);

      allow delete: if isAdmin();
    }

    // ===== transactions =====
    match /transactions/{id} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.date is timestamp
        && request.resource.data.type in ['income', 'expense']
        && isNonEmptyString(request.resource.data.categoryId)
        && isNonEmptyString(request.resource.data.categoryName)
        && isNonNegative(request.resource.data.unitPrice)
        && isNonNegative(request.resource.data.quantity)
        && isNonNegative(request.resource.data.totalAmount)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.date is timestamp
        && request.resource.data.type in ['income', 'expense']
        && isNonEmptyString(request.resource.data.categoryId)
        && isNonNegative(request.resource.data.unitPrice)
        && isNonNegative(request.resource.data.quantity)
        && isNonNegative(request.resource.data.totalAmount);

      allow delete: if isAdmin();
    }

    // ===== Все інше — заборонено =====
    match /{document=**} { allow read, write: if false; }
  }
}
