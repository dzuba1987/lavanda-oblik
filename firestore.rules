rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isAuthed()
        && userExists(request.auth.uid)
        && userDoc(request.auth.uid).role == 'admin';
    }

    function isValidRole(role) {
      return role in ['admin', 'seller', 'viewer'];
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    function isOptionalString(v) {
      return v == null || v is string;
    }

    function isNonNegative(v) {
      return v is number && v >= 0;
    }

    // ===== users =====
    match /users/{uid} {
      allow read: if isAuthed();

      // Юзер сам створює свій документ при першому вході.
      // Дозволяємо роль 'admin' тільки якщо це САМ-перший користувач у системі
      // (на практиці перевіряємо клієнтом; для додаткової безпеки після bootstrap
      // адмін через консоль може посилити правило).
      allow create: if isAuthed()
        && request.auth.uid == uid
        && request.resource.data.email is string
        && isOptionalString(request.resource.data.name)
        && isValidRole(request.resource.data.role);

      // Юзер може редагувати свій документ, АЛЕ не може змінити роль.
      // Роль змінює тільки адмін.
      allow update: if isAuthed() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role)
        || (isAdmin() && isValidRole(request.resource.data.role))
      );

      // Видалення:
      //   • будь-який адмін може відхиляти заявки (resource.role == 'viewer')
      //   • затверджених admin/seller може видаляти лише власник системи
      //     (зашитий email — щоб уникнути ситуації коли інший admin прибирає
      //      когось випадково)
      allow delete: if isAdmin() && (
        resource.data.role == 'viewer'
        || request.auth.token.email == 'dzubenko1987@gmail.com'
      );
    }

    // ===== categories =====
    match /categories/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.color is string;
      allow delete: if isAdmin();
    }

    // ===== products =====
    match /products/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && (request.resource.data.unit == null || request.resource.data.unit is string)
        && (request.resource.data.defaultPrice == null || isNonNegative(request.resource.data.defaultPrice))
        // Поля складу (опційні). stock може стати від'ємним при перепродажу.
        && (!('stock' in request.resource.data) || request.resource.data.stock == null || request.resource.data.stock is number)
        && (!('costPrice' in request.resource.data) || request.resource.data.costPrice == null || isNonNegative(request.resource.data.costPrice))
        && (!('notes' in request.resource.data) || request.resource.data.notes == null || request.resource.data.notes is string)
        && (!('photo' in request.resource.data) || request.resource.data.photo == null || request.resource.data.photo is string);
      allow delete: if isAdmin();
    }

    // ===== suppliers =====
    match /suppliers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isNonEmptyString(request.resource.data.name);
      allow delete: if isAdmin();
    }

    // ===== customers =====
    match /customers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && isNonEmptyString(request.resource.data.name);
      allow delete: if isAdmin();
    }

    // ===== bookings (записи на фотосесії) =====
    match /bookings/{id} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && isNonEmptyString(request.resource.data.customerName)
        && request.resource.data.start is timestamp
        && isNonNegative(request.resource.data.durationMin)
        && request.resource.data.status in ['tentative', 'confirmed', 'done', 'cancelled']
        && isOptionalString(request.resource.data.phone)
        && isOptionalString(request.resource.data.type)
        && (request.resource.data.price == null || isNonNegative(request.resource.data.price))
        && (request.resource.data.customerId == null || request.resource.data.customerId is string)
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['unpaid', 'paid'])
        && (!('paymentMethod' in request.resource.data) || request.resource.data.paymentMethod == null || request.resource.data.paymentMethod in ['cash', 'card'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isAdmin()
        && isNonEmptyString(request.resource.data.customerName)
        && request.resource.data.start is timestamp
        && isNonNegative(request.resource.data.durationMin)
        && request.resource.data.status in ['tentative', 'confirmed', 'done', 'cancelled']
        && (request.resource.data.price == null || isNonNegative(request.resource.data.price))
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['unpaid', 'paid'])
        && (!('paymentMethod' in request.resource.data) || request.resource.data.paymentMethod == null || request.resource.data.paymentMethod in ['cash', 'card'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isAdmin();
    }

    // ===== orders =====
    match /orders/{id} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.status in ['new', 'confirmed', 'in_progress', 'assembled', 'ready', 'delivered', 'cancelled']
        && isNonNegative(request.resource.data.totalAmount)
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 5
        && (request.resource.data.delivery == null
            || request.resource.data.delivery.method in ['nova_poshta', 'ukrposhta', 'meest', 'courier', 'self_pickup', 'other'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.status in ['new', 'confirmed', 'in_progress', 'assembled', 'ready', 'delivered', 'cancelled']
        && isNonNegative(request.resource.data.totalAmount)
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 5
        && (request.resource.data.delivery == null
            || request.resource.data.delivery.method in ['nova_poshta', 'ukrposhta', 'meest', 'courier', 'self_pickup', 'other'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isAdmin();

      // ===== orders/{id}/comments — потік коментарів =====
      match /comments/{commentId} {
        allow read: if isAdmin();

        allow create: if isAdmin()
          && isNonEmptyString(request.resource.data.text)
          && request.resource.data.text.size() <= 2000
          && request.resource.data.authorUid == request.auth.uid;

        // Видаляти тільки свої коментарі.
        allow delete: if isAdmin()
          && resource.data.authorUid == request.auth.uid;

        // Редагування не дозволяємо (immutable audit).
        allow update: if false;
      }
    }

    // ===== settings (telegram notification config, etc.) =====
    match /settings/{id} {
      // Будь-який залогінений читає — клієнт перевіряє notifyNewUser/notifyNewOrder
      // перед викликом Telegram-бекенду. Чутливі дані сюди не складаємо.
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ===== transactions =====
    match /transactions/{id} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.date is timestamp
        && request.resource.data.type in ['income', 'expense']
        && isNonEmptyString(request.resource.data.categoryId)
        && isNonEmptyString(request.resource.data.categoryName)
        && isNonNegative(request.resource.data.unitPrice)
        && isNonNegative(request.resource.data.quantity)
        && isNonNegative(request.resource.data.totalAmount)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.date is timestamp
        && request.resource.data.type in ['income', 'expense']
        && isNonEmptyString(request.resource.data.categoryId)
        && isNonNegative(request.resource.data.unitPrice)
        && isNonNegative(request.resource.data.quantity)
        && isNonNegative(request.resource.data.totalAmount)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isAdmin();
    }

    // ===== Все інше — заборонено =====
    match /{document=**} { allow read, write: if false; }
  }
}
