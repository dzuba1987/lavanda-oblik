# Firebase конфігурація (взяти з Firebase Console → Project Settings → Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Опційно — для emulator у локальній розробці
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Telegram-сповіщення через Laravel-бекенд `invest-notify`
# (endpoints під /api/lavanda/telegram/*). Залиште порожніми, якщо
# не використовуєте — frontend тоді просто не робить виклики.
NEXT_PUBLIC_NOTIFY_API_BASE=
NEXT_PUBLIC_NOTIFY_API_KEY=
NEXT_PUBLIC_LAVANDA_BOT_NAME=lavanda_oblik_bot
